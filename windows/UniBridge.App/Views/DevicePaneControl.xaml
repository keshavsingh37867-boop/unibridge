<UserControl x:Class="UniBridge.App.Views.DevicePaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="Root_DragOver"
             DragLeave="Root_DragLeave"
             Drop="Root_Drop">
    <Border x:Name="PaneCard"
            Background="{StaticResource BgSurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Endpoint Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding Endpoints}"
                                  SelectedItem="{Binding SelectedEndpoint, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E3A8A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Platform}" Value="Pendrive">
                                                            <Setter Property="Background" Value="#0F766E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="AndroidMTP">
                                                            <Setter Property="Background" Value="#15803D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="AndroidADB">
                                                            <Setter Property="Background" Value="#166534" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="IOSMedia">
                                                            <Setter Property="Background" Value="#6D28D9" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Platform}" Value="IOSApp">
                                                            <Setter Property="Background" Value="#7C3AED" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE7F4;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Platform}" Value="Pendrive">
                                                                <Setter Property="Text" Value="&#xE88E;" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Platform}" Value="AndroidMTP">
                                                                <Setter Property="Text" Value="&#xE8EA;" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Platform}" Value="AndroidADB">
                                                                <Setter Property="Text" Value="&#xE8EA;" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Platform}" Value="IOSMedia">
                                                                <Setter Property="Text" Value="&#xE8EA;" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Platform}" Value="IOSApp">
                                                                <Setter Property="Text" Value="&#xE74C;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Content="Folder..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Pin any Windows folder as a quick target"
                                Margin="8,0,0,0"
                                Click="PickFolder_Click" />

                        <Button Grid.Column="2"
                                Content="Eject"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding CanEject, Converter={StaticResource BoolToVis}}"
                                ToolTip="Safely eject USB pendrive"
                                Margin="8,0,0,0"
                                Click="EjectDrive_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="2,6,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FreeSpaceSummary}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2">
                            <TextBlock Text="{Binding SelectedEndpoint.DetailBadge, FallbackValue=Ready}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. Windows Quick Folders Bar -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6"
                    Visibility="{Binding ShowQuickFolders, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding QuickFolders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,4"
                                    Margin="0,0,6,2"
                                    Click="QuickFolder_Click"
                                    Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBlueBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 3. Navigation, Breadcrumbs, Search & Sort -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BackCommand}"
                                    ToolTip="Back"
                                    Padding="8,4"
                                    Margin="0,0,4,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ForwardCommand}"
                                    ToolTip="Forward"
                                    Padding="8,4"
                                    Margin="0,0,4,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding UpCommand}"
                                    ToolTip="Up to parent folder"
                                    Padding="8,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74A;" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource BgBaseBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="›"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="4,0"
                                                           VerticalAlignment="Center" />
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        Cursor="Hand"
                                                        Padding="4,2"
                                                        Content="{Binding Title}"
                                                        Tag="{Binding}"
                                                        Click="Breadcrumb_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Create New Folder"
                                    Padding="8,4"
                                    Margin="0,0,4,0"
                                    IsEnabled="{Binding CanModifyFilesystem}"
                                    Click="NewFolder_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Refresh Folder"
                                    Padding="8,4">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="26,5,8,5" />
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="Filter folder..."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="28,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedValue="{Binding SortField, Mode=TwoWay}"
                                  SelectedValuePath="Field"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="105"
                                  Margin="8,0,4,0" />

                        <Button Grid.Column="2"
                                Content="{Binding SortDirectionGlyph}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleSortDirectionCommand}"
                                ToolTip="Toggle sort ascending/descending"
                                MinWidth="32" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. File Browser List / Attention / Empty / Loading States -->
            <Grid Grid.Row="3">
                <ListView x:Name="FileListView"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ItemsSource="{Binding VisibleEntries}"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                          MouseMove="FileListView_MouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy to Other Pane" Click="CopyToOther_Click" />
                            <MenuItem Header="Move to Other Pane" Click="MoveToOther_Click" />
                            <Separator />
                            <MenuItem Header="New Folder..." Click="NewFolder_Click" />
                            <MenuItem Header="Rename..." Click="Rename_Click" />
                            <MenuItem Header="Delete..." Click="Delete_Click" />
                            <Separator />
                            <MenuItem Header="Open / Launch" Click="OpenSelected_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="RowBg"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Margin="4,1"
                                                Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBg" Property="Background" Value="#212936" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBg" Property="Background" Value="#1E3A5F" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="{Binding IconGlyph}"
                                                       Foreground="{Binding IconColor}"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplaySize}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modified" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayDate}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Kind" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KindDescription}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8B7;"
                               FontSize="36"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding EmptyStateText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Attention Overlay (Locked Phone / Trust / USB Debugging) -->
                <Border Background="{StaticResource BgBaseBrush}"
                        Visibility="{Binding ShowAttentionOverlay, Converter={StaticResource BoolToVis}}"
                        Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <Border Width="54" Height="54" CornerRadius="27" Background="#3B250E" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE72E;"
                                       FontSize="24"
                                       Foreground="{StaticResource WarningAmberBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding SelectedEndpoint.Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding SelectedEndpoint.StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16" />
                        <Button Content="Retry / Rescan Devices"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Click="Rescan_Click" />
                    </StackPanel>
                </Border>

                <!-- Error Banner -->
                <Border VerticalAlignment="Top"
                        Margin="10"
                        Padding="12,8"
                        Background="#3D1A1D"
                        BorderBrush="#7F2931"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <!-- Loading Bar -->
                <ProgressBar VerticalAlignment="Top"
                             Height="3"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Foreground="{StaticResource AccentBlueBrush}"
                             Background="Transparent"
                             BorderThickness="0" />

                <!-- Drop Overlay Highlight -->
                <Border x:Name="DropHighlightBorder"
                        BorderBrush="{StaticResource AccentBlueBrush}"
                        BorderThickness="2"
                        Background="#1A3B82F6"
                        CornerRadius="8"
                        Margin="6"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock Text="Drop files or folders here to transfer"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- 5. Footer -->
            <Border Grid.Row="4"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,6">
                <TextBlock Text="{Binding SelectionSummary}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
