<Window x:Class="UniBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UniBridge.App.Views"
        Title="UniBridge — Universal File Transfer"
        Width="1360"
        Height="840"
        MinWidth="1100"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top App Header & Controls -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBlueBrush}" Margin="0,0,12,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8AB;"
                                   FontSize="17"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UniBridge"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Windows • USB / OTG • Android • iOS"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectedDeviceCount}" Value="0">
                                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectedSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⇄ Swap Panes"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SwapPanesCommand}"
                            Margin="0,0,8,0" />

                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding ConflictPolicies}"
                              SelectedItem="{Binding SelectedConflictPolicy, Mode=TwoWay}"
                              MinWidth="195"
                              Margin="0,0,8,0" />

                    <ToggleButton IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}"
                                  Content="Hidden"
                                  Cursor="Hand"
                                  Padding="10,5"
                                  Margin="0,0,8,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        Background="{StaticResource BgElevatedBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1E3A5F" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Content="↻ Rescan"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RescanCommand}"
                            MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dual Pane Browser + Transfer Controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="106" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:DevicePaneControl x:Name="LeftPaneView"
                                     Grid.Column="0"
                                     DataContext="{Binding LeftPane}" />

            <!-- Middle Transfer Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Left → Right"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CopyLeftToRightCommand}"
                        Padding="8,10"
                        Margin="0,0,0,6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="➔" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="Copy" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding MoveLeftToRightCommand}"
                        Padding="8,7"
                        Margin="0,0,0,16">
                    <TextBlock Text="Move →" FontSize="12" HorizontalAlignment="Center" />
                </Button>

                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="6,0,6,16" />

                <TextBlock Text="Right → Left"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <Button Style="{StaticResource TealButtonStyle}"
                        Command="{Binding CopyRightToLeftCommand}"
                        Padding="8,10"
                        Margin="0,0,0,6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⬅" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="Copy" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding MoveRightToLeftCommand}"
                        Padding="8,7">
                    <TextBlock Text="← Move" FontSize="12" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>

            <views:DevicePaneControl x:Name="RightPaneView"
                                     Grid.Column="2"
                                     DataContext="{Binding RightPane}" />
        </Grid>

        <!-- 3. Bottom Transfer Queue Drawer -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,12,0,0"
                Padding="12,8">
            <Expander IsExpanded="{Binding IsTransfersExpanded, Mode=TwoWay}"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Transfers"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Jobs.Count, StringFormat=' ({0})'}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear Finished"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearFinishedJobsCommand}"
                                FontSize="11"
                                Padding="8,3"
                                Margin="14,0,0,0" />
                    </StackPanel>
                </Expander.Header>

                <Grid Margin="0,8,0,0" MaxHeight="165">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgBaseBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{StaticResource BgElevatedBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding StateLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StateColor}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ProgressBar Value="{Binding ProgressPercent}"
                                                             Maximum="100"
                                                             Height="7"
                                                             Foreground="{Binding StateColor}"
                                                             Background="{StaticResource BgElevatedBrush}"
                                                             BorderThickness="0"
                                                             Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding CurrentFileName}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatsLine}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="#FCA5A5"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Pause"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding PauseCommand}"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Resume"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding ResumeCommand}"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Cancel"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding CancelCommand}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,3" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="No transfers yet — pick devices in both panes, select files, and click Copy/Move or drag &amp; drop."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Jobs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</Window>
