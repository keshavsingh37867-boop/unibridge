<Window x:Class="UniBridge.App.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Already Exists"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgSurfaceBrush}">
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚠" FontSize="22" Foreground="{StaticResource WarningAmberBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock Text="Destination file already exists"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Prompt.SourceName}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource AccentBlueBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Prompt.DestinationPathDisplay}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgBaseBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="SOURCE (NEW)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SourceSizeText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SourceDateText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource BgBaseBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="EXISTING DESTINATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningAmberBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DestSizeText}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DestDateText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <CheckBox IsChecked="{Binding ApplyToAll}"
                  Content="Apply this choice to all remaining conflicts in this transfer"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Margin="0,0,0,18" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel All"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="CancelAll_Click" />

            <Button Grid.Column="2"
                    Content="Skip"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="76"
                    Margin="0,0,8,0"
                    Click="Skip_Click" />

            <Button Grid.Column="3"
                    Content="Keep Both"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="KeepBoth_Click" />

            <Button Grid.Column="4"
                    Content="Replace"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="84"
                    IsDefault="True"
                    Click="Replace_Click" />
        </Grid>
    </StackPanel>
</Window>
